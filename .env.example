# Copy to `.env.local` for development. Every variable is documented here — if you
# add one to the code, add it here in the same commit.

# The canonical origin. Everything absolute derives from it: canonical tags, OG
# image URLs, sitemap entries and JSON-LD @ids. Set this to the real domain before
# a production build — a wrong canonical is worse than no canonical.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Search Console verification token. Optional: when unset, no verification
# meta tag is emitted at all (an empty one reads as a failed claim).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
