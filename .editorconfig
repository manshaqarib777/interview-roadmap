# Matches the existing code: 2 spaces, LF, single trailing newline.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Trailing whitespace is a hard line break in markdown.
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2
